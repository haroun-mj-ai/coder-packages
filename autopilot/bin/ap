#!/usr/bin/env bash
# Autopilot CLI: up / down / status / pause / resume / runs / run / tail / watch.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/ap-env.sh"

CRONTAB_TEMPLATE="$(cd "$SCRIPT_DIR/.." && pwd)/crontab"
CRONTAB_RENDERED="$AP_HOME/crontab.rendered"
TMUX_SESSION="autopilot"

usage() {
  echo "Usage: ap {up [--quiet]|down|status|pause|resume|runs|run|tail|watch|sweep|decide|--print-paths}" >&2
  echo "  runs [-n N]    List recent acts; live ones are marked LIVE." >&2
  echo "  run  [TARGET]  One act in detail: main-loop model, tokens, tool mix," >&2
  echo "                 status.json, stderr, final message. --timeline for" >&2
  echo "                 every tool call it made." >&2
  echo "  tail [TARGET]  Follow an act as it works, or replay a finished one." >&2
  echo "  watch          tmux pane per live act, each tailing it." >&2
  echo "  sweep [--yes]  Remove merged+clean wt-eng* worktrees and their local" >&2
  echo "                 branches. Defaults to --dry-run (report only); pass" >&2
  echo "                 --yes to actually remove. Never --force, never" >&2
  echo "                 'branch -D'." >&2
  echo "  decide         Run the deterministic decider (ap-decide.sh --dry-run)" >&2
  echo "                 against the REAL inbox, no writes, and pretty-print the" >&2
  echo "                 decision plus a one-line reason per tier it evaluated --" >&2
  echo "                 for comparing against what AP_POLL_MODE=model actually" >&2
  echo "                 chose before flipping to AP_POLL_MODE=deterministic." >&2
  echo "  TARGET is a session-id prefix, an issue id (ENG-1234), or 'latest'." >&2
  echo "  --print-paths  Debug: render the crontab and print resolved paths" >&2
  echo "                 (script dir, crontab template/rendered, AP_HOME); exits 0." >&2
  exit 1
}

# An act is a headless `claude -p`, so there is no pane to attach to. These
# four read its transcript, run dir and ledger row instead; the backend is one
# python script so the joining logic lives in one place.
RUNS_PY="$SCRIPT_DIR/ap-runs.py"
cmd_runs() { python3 "$RUNS_PY" list "$@"; }
cmd_run() { python3 "$RUNS_PY" show "$@"; }
cmd_tail() { python3 -u "$RUNS_PY" tail "$@"; }
cmd_watch() { python3 "$RUNS_PY" watch "$@"; }
cmd_sweep() { "$SCRIPT_DIR/ap-sweep.sh" "$@"; }

# `ap decide` runs the deterministic decider in --dry-run (no gh writes,
# ever) against the REAL inbox, and pretty-prints the decision plus its
# per-tier trace, so the owner can compare it against what the model poll
# actually chose on live data before flipping AP_POLL_MODE. See
# autopilot/README.md's "poll modes" section.
cmd_decide() {
  local out_file err_file
  out_file="$(mktemp)"
  err_file="$(mktemp)"
  "$SCRIPT_DIR/ap-decide.sh" --dry-run >"$out_file" 2>"$err_file"

  echo "decision (dry-run -- no gh writes were performed):"
  python3 -c '
import json, sys
try:
    print(json.dumps(json.load(sys.stdin), indent=2))
except Exception:
    print(sys.stdin.read(), end="")
' <"$out_file" | sed 's/^/  /'

  echo
  echo "reasoning (one line per tier evaluated):"
  if [[ -s "$err_file" ]]; then
    sed 's/^/  /' "$err_file"
  else
    echo "  (no trace produced)"
  fi

  rm -f "$out_file" "$err_file"
}

session_alive() {
  tmux has-session -t "$TMUX_SESSION" 2>/dev/null
}

# render_crontab: writes $CRONTAB_RENDERED from $CRONTAB_TEMPLATE with the
# CRON_TZ line replaced by the current AP_TZ (sourced from ap-env.sh above).
render_crontab() {
  mkdir -p "$AP_HOME"
  sed "s|^CRON_TZ=.*|CRON_TZ=$AP_TZ|" "$CRONTAB_TEMPLATE" >"$CRONTAB_RENDERED"
}

cmd_up() {
  local quiet=false
  [[ "${1:-}" == "--quiet" ]] && quiet=true

  mkdir -p "$AP_HOME" "$AP_HOME/runs" "$AP_HOME/logs"
  render_crontab

  if session_alive; then
    [[ "$quiet" == true ]] || echo "autopilot already running (tmux session '$TMUX_SESSION')"
    return 0
  fi

  # -overlapping is REQUIRED, not a tuning knob: without it supercronic skips
  # every tick while the previous ap-cycle.sh is still alive ("not starting:
  # job is still running"), and a cycle lives as long as its act -- 30+ min
  # for a build. That serializes the whole pipeline no matter how many lanes
  # are free. Overlap is safe because ap-cycle.sh owns its own mutual
  # exclusion: lock.poll serializes deciding, lock.plan/lock.build cap each
  # lane at one occupant, and a cycle with nothing to do exits in seconds.
  # -c pins the session's cwd to the work repo so no cycle ever inherits the
  # directory `ap up` was typed in (skill discovery is cwd-based; ap-cycle.sh
  # cd's too, but belt and braces).
  tmux new-session -d -s "$TMUX_SESSION" -c "${AP_WORK_REPO:-/home/coder/root-for-local}" \
    "supercronic -overlapping '$CRONTAB_RENDERED'"
  [[ "$quiet" == true ]] || echo "autopilot started (tmux session '$TMUX_SESSION')"
}

cmd_print_paths() {
  mkdir -p "$AP_HOME"
  render_crontab
  echo "SCRIPT_DIR=$SCRIPT_DIR"
  echo "AP_HOME=$AP_HOME"
  echo "AP_TZ=$AP_TZ"
  echo "CRONTAB_TEMPLATE=$CRONTAB_TEMPLATE"
  echo "CRONTAB_RENDERED=$CRONTAB_RENDERED"
}

# lane_free <lock-file> -- non-destructive probe, same helper ap-cycle.sh uses:
# open on a spare fd, flock -n, release immediately. rc 0 = free, 1 = busy.
lane_free() {
  local lock_file="$1"
  local fd
  exec {fd}>"$lock_file" || return 1
  if flock -n "$fd"; then
    flock -u "$fd"
    exec {fd}>&-
    return 0
  fi
  exec {fd}>&-
  return 1
}

cmd_down() {
  local force=false
  [[ "${1:-}" == "--force" ]] && force=true

  # Killing the session can take a running act down with it -- a build is tens
  # of minutes and real money (a standalone ship is cheaper, but still a live
  # PR-open/CI-wait in flight). Refuse while a lane is occupied unless forced;
  # `ap pause` is the way to stop NEW work without touching what is in flight.
  # Every build slot AND every ship slot counts here, not just "all full": a
  # single occupied slot is still an act in flight that killing the session
  # would take down.
  if [[ "$force" == false ]]; then
    local busy="" build_busy="" ship_busy=""
    for ((n = 1; n <= AP_BUILD_SLOTS; n++)); do
      lane_free "$AP_HOME/lock.build.$n" || build_busy="${build_busy:+$build_busy,}build.$n"
    done
    [[ -n "$build_busy" ]] && busy="$build_busy"
    for ((n = 1; n <= AP_SHIP_SLOTS; n++)); do
      lane_free "$AP_HOME/lock.ship.$n" || ship_busy="${ship_busy:+$ship_busy,}ship.$n"
    done
    [[ -n "$ship_busy" ]] && busy="${busy:+$busy,}$ship_busy"
    lane_free "$AP_HOME/lock.plan" || busy="${busy:+$busy,}plan"
    if [[ -n "$busy" ]]; then
      echo "refusing: lane(s) busy ($busy) -- an act is running and would be killed." >&2
      echo "use 'ap pause' to stop new work, or 'ap down --force' to kill anyway." >&2
      return 1
    fi
  fi

  if session_alive; then
    tmux kill-session -t "$TMUX_SESSION"
    echo "autopilot stopped"
  else
    echo "autopilot not running"
  fi
}

cmd_status() {
  if session_alive; then
    echo "session:  alive (tmux '$TMUX_SESSION')"
  else
    echo "session:  DOWN"
  fi

  if [[ -e "$AP_HOME/pause" ]]; then
    local pause_reason
    pause_reason="$(head -n1 "$AP_HOME/pause" 2>/dev/null)"
    if [[ -z "$pause_reason" ]]; then
      echo "pause:    PAUSED ($AP_HOME/pause exists)"
    elif [[ "$pause_reason" == "usage-limit" ]]; then
      if [[ "${AP_LIMIT_COOLDOWN_MIN:-60}" -le 0 ]]; then
        echo "pause:    PAUSED (reason: usage-limit; auto-resume disabled, AP_LIMIT_COOLDOWN_MIN=0)"
      else
        local pause_mtime resume_epoch resume_time
        pause_mtime="$(stat -c %Y "$AP_HOME/pause" 2>/dev/null || echo 0)"
        resume_epoch=$(( pause_mtime + AP_LIMIT_COOLDOWN_MIN * 60 ))
        resume_time="$(date -u -d "@$resume_epoch" +%FT%TZ 2>/dev/null || echo unknown)"
        echo "pause:    PAUSED (reason: usage-limit; auto-resumes at $resume_time UTC or the next cycle after)"
      fi
    else
      echo "pause:    PAUSED (reason: $pause_reason)"
    fi
  else
    echo "pause:    running"
  fi

  local busy_slots=0 slot_detail=""
  for ((n = 1; n <= AP_BUILD_SLOTS; n++)); do
    if lane_free "$AP_HOME/lock.build.$n"; then
      slot_detail="${slot_detail:+$slot_detail }slot$n=free"
    else
      slot_detail="${slot_detail:+$slot_detail }slot$n=busy"
      busy_slots=$((busy_slots + 1))
    fi
  done
  echo "build slots: $busy_slots/$AP_BUILD_SLOTS busy ($slot_detail)"

  # Ship lane's own slot pool (see ap-env.sh's AP_SHIP_SLOTS comment) --
  # capped higher than build because a standalone ship act is almost pure
  # CI-wait, not a build.
  local ship_busy_slots=0 ship_slot_detail=""
  for ((n = 1; n <= AP_SHIP_SLOTS; n++)); do
    if lane_free "$AP_HOME/lock.ship.$n"; then
      ship_slot_detail="${ship_slot_detail:+$ship_slot_detail }slot$n=free"
    else
      ship_slot_detail="${ship_slot_detail:+$ship_slot_detail }slot$n=busy"
      ship_busy_slots=$((ship_busy_slots + 1))
    fi
  done
  echo "ship slots:  $ship_busy_slots/$AP_SHIP_SLOTS busy ($ship_slot_detail)"

  if lane_free "$AP_HOME/lock.plan"; then
    echo "plan lane:   free"
  else
    echo "plan lane:   busy"
  fi

  local today ledger_file
  today="$(TZ="$AP_TZ" date +%F)"
  ledger_file="$AP_HOME/runs/$today.jsonl"
  echo "ledger:   $ledger_file"
  if [[ -f "$ledger_file" ]]; then
    tail -n 3 "$ledger_file" | sed 's/^/  /'

    local last_ts now_ts age
    last_ts="$(tail -n 1 "$ledger_file" | python3 -c "
import json, sys, datetime
try:
    d = json.loads(sys.stdin.read())
    ts = d.get('ts', '')
    dt = datetime.datetime.strptime(ts, '%Y-%m-%dT%H:%M:%SZ')
    print(int(dt.replace(tzinfo=datetime.timezone.utc).timestamp()))
except Exception:
    print(0)
")"
    now_ts="$(date -u +%s)"
    if [[ "$last_ts" -gt 0 ]]; then
      age=$(( now_ts - last_ts ))
      if [[ "$age" -gt 3600 ]]; then
        echo "warning:  no ledger entry in $((age / 60)) minutes (>1h) — is the scheduler alive?"
      fi
    fi
  else
    echo "  (no entries yet today)"
  fi

  # Rolling 7-day cost, across whatever daily ledger files exist -- not a
  # calendar week, just "last 7 files on disk" (simplest thing that's still
  # useful; ledgers roll daily and old ones aren't pruned). Informational
  # only: nothing auto-pauses on AP_MAX_WEEK_COST_USD, this just reports
  # against it. See ap-env.sh for why this is a SHARE of the account's pool,
  # not the whole thing.
  local week_files week_cost
  # Ledger filenames are our own YYYY-MM-DD.jsonl, never contain whitespace
  # or globbing metacharacters -- ls+word-splitting is safe here.
  # shellcheck disable=SC2012
  week_files="$(ls -1t "$AP_HOME"/runs/*.jsonl 2>/dev/null | head -7)"
  if [[ -n "$week_files" ]]; then
    if command -v jq >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      week_cost="$(jq -s '[.[] | .cost] | add // 0' $week_files 2>/dev/null)"
    else
      # shellcheck disable=SC2086
      week_cost="$(python3 - $week_files <<'PYEOF'
import json, sys
cost = 0.0
for path in sys.argv[1:]:
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue
            cost += float(d.get("cost") or 0)
print(cost)
PYEOF
)"
    fi
    printf "week cost: \$%.2f / \$%s (last %d daily ledgers, share of the account's weekly pool -- see ap-env.sh)\n" \
      "${week_cost:-0}" "$AP_MAX_WEEK_COST_USD" "$(wc -w <<<"$week_files")"
  fi
}

cmd_pause() {
  mkdir -p "$AP_HOME"
  # Reason "manual" never auto-clears (see ap-cycle.sh's pause-reason
  # handling) -- only a pause the wrapper itself wrote for a usage-limit
  # failure does.
  echo "manual" >"$AP_HOME/pause"
  echo "paused (rm $AP_HOME/pause, or 'ap resume', to resume)"
}

cmd_resume() {
  rm -f "$AP_HOME/pause"
  echo 0 >"$AP_HOME/fail_count"
  echo "resumed"
}

[[ $# -ge 1 ]] || usage
sub="$1"; shift
case "$sub" in
  up) cmd_up "${1:-}" ;;
  down) cmd_down ;;
  status) cmd_status ;;
  pause) cmd_pause ;;
  resume) cmd_resume ;;
  runs) cmd_runs "$@" ;;
  run) cmd_run "$@" ;;
  tail) cmd_tail "$@" ;;
  watch) cmd_watch "$@" ;;
  sweep) cmd_sweep "$@" ;;
  decide) cmd_decide "$@" ;;
  --print-paths) cmd_print_paths ;;
  *) usage ;;
esac
