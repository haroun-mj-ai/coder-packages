#!/usr/bin/env bash
# Autopilot CLI: up / down / status / pause / resume / runs / run / tail /
# watch / queue / approve / reply / retry.
#
# All intake, plan approval, blocking-question answers and ship retries are
# CLI-only (queue/approve/reply/retry, backed by $AP_HOME/queue/<ENG-ID>.json
# -- see ap_queue.py) -- there is no GitHub inbox and no haiku poll.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/ap-env.sh"

CRONTAB_TEMPLATE="$(cd "$SCRIPT_DIR/.." && pwd)/crontab"
CRONTAB_RENDERED="$AP_HOME/crontab.rendered"
TMUX_SESSION="${AP_TMUX_SESSION:-autopilot}"

usage() {
  echo "Usage: ap {up [--quiet]|down|status|pause|resume|reset-week|runs|run|tail|watch|sweep|sessions|pause-act|resume-act|retry|queue|approve|reply|decide|--print-paths}" >&2
  echo "  queue ENG-<id> [NOTE] [--auto]  New-work intake: queue a ticket for" >&2
  echo "                 the pipeline (replaces opening a GitHub inbox issue)." >&2
  echo "                 --auto also sets this ticket's persistent" >&2
  echo "                 auto-approve switch." >&2
  echo "  approve ENG-<id> [--auto]       Approve a plan-review ticket (\"go\")" >&2
  echo "                 so it builds. --auto also flips its persistent" >&2
  echo "                 auto-approve switch for future phases." >&2
  echo "  reply ENG-<id> TEXT             Leave plan-revision feedback, or" >&2
  echo "                 answer a needs-input blocking question -- routes by" >&2
  echo "                 the ticket's current state either way." >&2
  echo "  reset-week [SEED] [--days N]    Re-anchor the weekly cost window to" >&2
  echo "                 now; it then resets every N days (default 7). SEED" >&2
  echo "                 starts the count at a dollar amount (43.40) or a" >&2
  echo "                 percentage of the weekly cap (14%), for syncing to the" >&2
  echo "                 account's real usage -- the pipeline's ledger only sees" >&2
  echo "                 its own spend, not interactive sessions'. SEED applies" >&2
  echo "                 to the first period only. Never edits past ledgers." >&2
  echo "  runs [-n N]    List recent acts; live ones are marked LIVE." >&2
  echo "  run  [TARGET]  One act in detail: main-loop model, tokens, tool mix," >&2
  echo "                 status.json, stderr, final message. --timeline for" >&2
  echo "                 every tool call it made." >&2
  echo "  tail [TARGET]  Follow an act as it works, or replay a finished one." >&2
  echo "  watch          tmux pane per live act, each tailing it." >&2
  echo "  sweep [--yes]  Remove merged+clean wt-eng* worktrees and their local" >&2
  echo "                 branches. Defaults to --dry-run (report only); pass" >&2
  echo "                 --yes to actually remove. Never --force, never" >&2
  echo "                 'branch -D'." >&2
  echo "  sessions       Interactive dashboard: live acts + queue tickets" >&2
  echo "                 awaiting a decision + each other issue's last outcome," >&2
  echo "                 numbered. Select one to see detail and, if applicable," >&2
  echo "                 a one-key action: pause/attach a live act, approve or" >&2
  echo "                 reply to a plan-review/needs-input ticket, or retry a" >&2
  echo "                 failed one." >&2
  echo "  pause-act [TARGET]        Interrupt one live persistent act mid-turn" >&2
  echo "                 (Escape) -- resumable, unlike 'ap pause' which only" >&2
  echo "                 stops NEW dispatches. Note: does NOT free its lane" >&2
  echo "                 slot -- ap-cycle.sh is still waiting on it." >&2
  echo "  resume-act [TARGET] [MESSAGE]   Resume an interrupted/idle live act" >&2
  echo "                 by injecting MESSAGE (default: \"continue\")." >&2
  echo "  retry [TARGET] Re-queue a FAILED act to the state it started from" >&2
  echo "                 (same requeue an external-failure signature already" >&2
  echo "                 does automatically), so the next cycle picks it up." >&2
  echo "  decide         Run the decider (ap-decide.sh --dry-run) against the" >&2
  echo "                 REAL local queue, no writes, and pretty-print the" >&2
  echo "                 decision plus a one-line reason per tier it evaluated." >&2
  echo "  TARGET is a session-id prefix, an issue id (ENG-1234), or 'latest'." >&2
  echo "  --print-paths  Debug: render the crontab and print resolved paths" >&2
  echo "                 (script dir, crontab template/rendered, AP_HOME); exits 0." >&2
  exit 1
}

# A persistent-mode act (the default) runs in a real tmux window (`ap
# sessions`'s [a]ttach jumps a terminal into it); these commands read its
# transcript, run dir and ledger row, or mutate the local queue -- the
# backend is one python script so the joining logic lives in one place.
RUNS_PY="$SCRIPT_DIR/ap-runs.py"
# "ap runs" defaults to the "list" subcommand (so bare flags like "-n 5" still
# mean "list -n 5"), but a real ap-runs.py subcommand (cost/model/show/...)
# must pass straight through instead of getting "list" wedged in front of it.
RUNS_SUBCOMMANDS="list show tail watch cost model tail-text interrupt continue retry sessions queue approve reply"
cmd_runs() {
  if [ "$#" -gt 0 ] && [[ " $RUNS_SUBCOMMANDS " == *" $1 "* ]]; then
    python3 "$RUNS_PY" "$@"
  else
    python3 "$RUNS_PY" list "$@"
  fi
}
cmd_run() { python3 "$RUNS_PY" show "$@"; }
cmd_tail() { python3 -u "$RUNS_PY" tail "$@"; }
cmd_watch() { python3 "$RUNS_PY" watch "$@"; }
cmd_sweep() { "$SCRIPT_DIR/ap-sweep.sh" "$@"; }
cmd_pause_act() { python3 "$RUNS_PY" interrupt "${1:-latest}"; }
cmd_resume_act() { python3 "$RUNS_PY" continue "${1:-latest}" "${2:-continue}"; }
cmd_retry() { python3 "$RUNS_PY" retry "${1:-latest}"; }
cmd_sessions() { python3 "$RUNS_PY" sessions; }
cmd_queue() { python3 "$RUNS_PY" queue "$@"; }
cmd_approve() { python3 "$RUNS_PY" approve "$@"; }
cmd_reply() { python3 "$RUNS_PY" reply "$@"; }

# `ap decide` runs the decider in --dry-run (no queue writes, ever) against
# the REAL local queue, and pretty-prints the decision plus its per-tier
# trace -- useful for seeing what the next cycle would do without waiting
# for one, or for debugging why a ticket isn't advancing.
cmd_decide() {
  local out_file err_file
  out_file="$(mktemp)"
  err_file="$(mktemp)"
  "$SCRIPT_DIR/ap-decide.sh" --dry-run >"$out_file" 2>"$err_file"

  echo "decision (dry-run -- no queue writes were performed):"
  python3 -c '
import json, sys
try:
    print(json.dumps(json.load(sys.stdin), indent=2))
except Exception:
    print(sys.stdin.read(), end="")
' <"$out_file" | sed 's/^/  /'

  echo
  echo "reasoning (one line per tier evaluated):"
  if [[ -s "$err_file" ]]; then
    sed 's/^/  /' "$err_file"
  else
    echo "  (no trace produced)"
  fi

  rm -f "$out_file" "$err_file"
}

session_alive() {
  tmux has-session -t "$TMUX_SESSION" 2>/dev/null
}

# render_crontab: writes $CRONTAB_RENDERED from $CRONTAB_TEMPLATE with the
# CRON_TZ line replaced by the current AP_TZ (sourced from ap-env.sh above).
render_crontab() {
  mkdir -p "$AP_HOME"
  sed "s|^CRON_TZ=.*|CRON_TZ=$AP_TZ|" "$CRONTAB_TEMPLATE" >"$CRONTAB_RENDERED"
}

cmd_up() {
  local quiet=false
  [[ "${1:-}" == "--quiet" ]] && quiet=true

  mkdir -p "$AP_HOME" "$AP_HOME/runs" "$AP_HOME/logs"
  render_crontab

  if session_alive; then
    [[ "$quiet" == true ]] || echo "autopilot already running (tmux session '$TMUX_SESSION')"
    return 0
  fi

  # -overlapping is REQUIRED, not a tuning knob: without it supercronic skips
  # every tick while the previous ap-cycle.sh is still alive ("not starting:
  # job is still running"), and a cycle lives as long as its act -- 30+ min
  # for a build. That serializes the whole pipeline no matter how many lanes
  # are free. Overlap is safe because ap-cycle.sh owns its own mutual
  # exclusion: lock.poll serializes deciding, lock.plan/lock.build cap each
  # lane at one occupant, and a cycle with nothing to do exits in seconds.
  # -c pins the session's cwd to the work repo so no cycle ever inherits the
  # directory `ap up` was typed in (skill discovery is cwd-based; ap-cycle.sh
  # cd's too, but belt and braces).
  tmux new-session -d -s "$TMUX_SESSION" -c "${AP_WORK_REPO:-/home/coder/root-for-local}" \
    "supercronic -overlapping '$CRONTAB_RENDERED'"
  # Named so nothing doing `tmux list-windows` pattern-matching on `act_*`
  # (ap-runs.py's live-act detection, ap-cycle.sh's window_alive() checks)
  # ever confuses supercronic's own window for one of the act windows
  # AP_ACT_LAUNCH_MODE=persistent creates alongside it.
  tmux rename-window -t "$TMUX_SESSION:0" supercronic 2>/dev/null || true
  [[ "$quiet" == true ]] || echo "autopilot started (tmux session '$TMUX_SESSION')"
}

cmd_print_paths() {
  mkdir -p "$AP_HOME"
  render_crontab
  echo "SCRIPT_DIR=$SCRIPT_DIR"
  echo "AP_HOME=$AP_HOME"
  echo "AP_TZ=$AP_TZ"
  echo "CRONTAB_TEMPLATE=$CRONTAB_TEMPLATE"
  echo "CRONTAB_RENDERED=$CRONTAB_RENDERED"
}

# lane_free <lock-file> -- non-destructive probe, same helper ap-cycle.sh uses:
# open on a spare fd, flock -n, release immediately. rc 0 = free, 1 = busy.
lane_free() {
  local lock_file="$1"
  local fd
  exec {fd}>"$lock_file" || return 1
  if flock -n "$fd"; then
    flock -u "$fd"
    exec {fd}>&-
    return 0
  fi
  exec {fd}>&-
  return 1
}

cmd_down() {
  local force=false
  [[ "${1:-}" == "--force" ]] && force=true

  # Killing the session can take a running act down with it -- a build is tens
  # of minutes and real money (a standalone ship is cheaper, but still a live
  # PR-open/CI-wait in flight). Refuse while a lane is occupied unless forced;
  # `ap pause` is the way to stop NEW work without touching what is in flight.
  # Every build slot AND every ship slot counts here, not just "all full": a
  # single occupied slot is still an act in flight that killing the session
  # would take down.
  if [[ "$force" == false ]]; then
    local busy="" build_busy="" ship_busy=""
    for ((n = 1; n <= AP_BUILD_SLOTS; n++)); do
      lane_free "$AP_HOME/lock.build.$n" || build_busy="${build_busy:+$build_busy,}build.$n"
    done
    [[ -n "$build_busy" ]] && busy="$build_busy"
    for ((n = 1; n <= AP_SHIP_SLOTS; n++)); do
      lane_free "$AP_HOME/lock.ship.$n" || ship_busy="${ship_busy:+$ship_busy,}ship.$n"
    done
    [[ -n "$ship_busy" ]] && busy="${busy:+$busy,}$ship_busy"
    lane_free "$AP_HOME/lock.plan" || busy="${busy:+$busy,}plan"
    if [[ -n "$busy" ]]; then
      echo "refusing: lane(s) busy ($busy) -- an act is running and would be killed." >&2
      echo "use 'ap pause' to stop new work, or 'ap down --force' to kill anyway." >&2
      return 1
    fi

    # Parked acts hold no lane lock (that's the whole point -- see
    # ap-cycle.sh's park_registry_write), so the busy-lane check above can't
    # see them. `tmux kill-session` would silently take every one of them
    # down too -- refuse separately.
    local parked_count=0
    if [[ -d "$AP_HOME/parked" ]]; then
      parked_count="$(find "$AP_HOME/parked" -maxdepth 1 -name '*.json' | wc -l)"
    fi
    if [[ "$parked_count" -gt 0 ]]; then
      echo "refusing: $parked_count act(s) parked, waiting on a reply -- 'ap down' would kill them too." >&2
      echo "see 'ap status' for which issues, or 'ap down --force' to kill anyway." >&2
      return 1
    fi
  fi

  if session_alive; then
    tmux kill-session -t "$TMUX_SESSION"
    echo "autopilot stopped"
  else
    echo "autopilot not running"
  fi
}

cmd_status() {
  if session_alive; then
    echo "session:  alive (tmux '$TMUX_SESSION')"
  else
    echo "session:  DOWN"
  fi

  if [[ -e "$AP_HOME/pause" ]]; then
    local pause_reason
    pause_reason="$(head -n1 "$AP_HOME/pause" 2>/dev/null)"
    if [[ -z "$pause_reason" ]]; then
      echo "pause:    PAUSED ($AP_HOME/pause exists)"
    elif [[ "$pause_reason" == "usage-limit" ]]; then
      if [[ "${AP_LIMIT_COOLDOWN_MIN:-60}" -le 0 ]]; then
        echo "pause:    PAUSED (reason: usage-limit; auto-resume disabled, AP_LIMIT_COOLDOWN_MIN=0)"
      else
        local pause_mtime resume_epoch resume_time
        pause_mtime="$(stat -c %Y "$AP_HOME/pause" 2>/dev/null || echo 0)"
        resume_epoch=$(( pause_mtime + AP_LIMIT_COOLDOWN_MIN * 60 ))
        resume_time="$(date -u -d "@$resume_epoch" +%FT%TZ 2>/dev/null || echo unknown)"
        echo "pause:    PAUSED (reason: usage-limit; auto-resumes at $resume_time UTC or the next cycle after)"
      fi
    else
      echo "pause:    PAUSED (reason: $pause_reason)"
    fi
  else
    echo "pause:    running"
  fi

  local busy_slots=0 slot_detail=""
  for ((n = 1; n <= AP_BUILD_SLOTS; n++)); do
    if lane_free "$AP_HOME/lock.build.$n"; then
      slot_detail="${slot_detail:+$slot_detail }slot$n=free"
    else
      slot_detail="${slot_detail:+$slot_detail }slot$n=busy"
      busy_slots=$((busy_slots + 1))
    fi
  done
  echo "build slots: $busy_slots/$AP_BUILD_SLOTS busy ($slot_detail)"

  # Ship lane's own slot pool (see ap-env.sh's AP_SHIP_SLOTS comment) --
  # capped higher than build because a standalone ship act is almost pure
  # CI-wait, not a build.
  local ship_busy_slots=0 ship_slot_detail=""
  for ((n = 1; n <= AP_SHIP_SLOTS; n++)); do
    if lane_free "$AP_HOME/lock.ship.$n"; then
      ship_slot_detail="${ship_slot_detail:+$ship_slot_detail }slot$n=free"
    else
      ship_slot_detail="${ship_slot_detail:+$ship_slot_detail }slot$n=busy"
      ship_busy_slots=$((ship_busy_slots + 1))
    fi
  done
  echo "ship slots:  $ship_busy_slots/$AP_SHIP_SLOTS busy ($ship_slot_detail)"

  if lane_free "$AP_HOME/lock.plan"; then
    echo "plan lane:   free"
  else
    echo "plan lane:   busy"
  fi

  # Parked acts (AP_ACT_LAUNCH_MODE=persistent only): waiting on a reply,
  # holding no lane lock -- see ap-cycle.sh's park_registry_write. Cross-
  # check the window is actually still there; the manual-resume sweep in
  # ap-cycle.sh's own Stage 0.5 is what reconciles a STALE entry away, this
  # is read-only reporting, so a lagging one shows here as STALE rather than
  # silently vanishing from the list.
  if [[ -d "$AP_HOME/parked" ]] && compgen -G "$AP_HOME/parked/*.json" >/dev/null; then
    echo "parked acts:"
    local pf pissue pphase pwindow page_secs now_epoch parked_epoch
    now_epoch="$(date -u +%s)"
    for pf in "$AP_HOME"/parked/*.json; do
      [[ -e "$pf" ]] || continue
      pissue="$(python3 -c "import json,sys; print(json.load(open('$pf')).get('issue') or '?')" 2>/dev/null)"
      pphase="$(python3 -c "import json,sys; print(json.load(open('$pf')).get('phase') or '?')" 2>/dev/null)"
      pwindow="$(python3 -c "import json,sys; print(json.load(open('$pf')).get('window') or '?')" 2>/dev/null)"
      parked_epoch="$(python3 -c "
import json, datetime
try:
    ts = json.load(open('$pf')).get('parked_at', '')
    dt = datetime.datetime.strptime(ts, '%Y-%m-%dT%H:%M:%SZ')
    print(int(dt.replace(tzinfo=datetime.timezone.utc).timestamp()))
except Exception:
    print(0)
" 2>/dev/null)"
      age_secs=$(( now_epoch - ${parked_epoch:-0} ))
      if tmux list-windows -t "$TMUX_SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$pwindow"; then
        echo "  $pissue ($pphase) in $pwindow, parked $((age_secs / 60))m ago"
      else
        echo "  $pissue ($pphase) in $pwindow -- STALE (window missing; the next cycle's manual-resume sweep should clear this)"
      fi
    done
  fi

  local today ledger_file
  today="$(TZ="$AP_TZ" date +%F)"
  ledger_file="$AP_HOME/runs/$today.jsonl"
  echo "ledger:   $ledger_file"
  if [[ -f "$ledger_file" ]]; then
    tail -n 3 "$ledger_file" | sed 's/^/  /'

    local last_ts now_ts age
    last_ts="$(tail -n 1 "$ledger_file" | python3 -c "
import json, sys, datetime
try:
    d = json.loads(sys.stdin.read())
    ts = d.get('ts', '')
    dt = datetime.datetime.strptime(ts, '%Y-%m-%dT%H:%M:%SZ')
    print(int(dt.replace(tzinfo=datetime.timezone.utc).timestamp()))
except Exception:
    print(0)
")"
    now_ts="$(date -u +%s)"
    if [[ "$last_ts" -gt 0 ]]; then
      age=$(( now_ts - last_ts ))
      if [[ "$age" -gt 3600 ]]; then
        echo "warning:  no ledger entry in $((age / 60)) minutes (>1h) — is the scheduler alive?"
      fi
    fi
  else
    echo "  (no entries yet today)"
  fi

  # Anchored 7-day cost window -- see ap-week-cost.py for the definition and
  # for why it is anchored (resets on a fixed cadence) rather than rolling.
  # Informational only: nothing auto-pauses on AP_MAX_WEEK_COST_USD, this just
  # reports against it. See ap-env.sh for why this is a SHARE of the account's
  # pool, not the whole thing. `ap reset-week` re-anchors it.
  local week_json
  week_json="$(python3 "$SCRIPT_DIR/ap-week-cost.py" --home "$AP_HOME" --format json 2>/dev/null)"
  if [[ -n "$week_json" ]]; then
    python3 - "$week_json" "$AP_MAX_WEEK_COST_USD" <<'PYEOF'
import json, sys

d = json.loads(sys.argv[1])
cap = sys.argv[2]
line = "week cost: $%.2f / $%s" % (d["cost"], cap)
try:
    pct = 100.0 * d["cost"] / float(cap)
    line += " (%.0f%%)" % pct
except (ValueError, ZeroDivisionError):
    pass
if d["anchored"]:
    line += ", window %s -> %s, %.1fd left" % (
        d["window_start"][:10], d["window_end"][:10], d["days_left"])
    if d["baseline_applied"]:
        line += ", incl. $%.2f reset baseline" % d["baseline_usd"]
else:
    line += " (trailing 7 days, never reset -- run 'ap reset-week' to anchor)"
print(line)
PYEOF
  fi
}

cmd_pause() {
  mkdir -p "$AP_HOME"
  # Reason "manual" never auto-clears (see ap-cycle.sh's pause-reason
  # handling) -- only a pause the wrapper itself wrote for a usage-limit
  # failure does.
  echo "manual" >"$AP_HOME/pause"
  echo "paused (rm $AP_HOME/pause, or 'ap resume', to resume)"
}

cmd_resume() {
  rm -f "$AP_HOME/pause"
  echo 0 >"$AP_HOME/fail_count"
  echo "resumed"
}

# Re-anchor the weekly cost window to now, optionally seeding it with the
# account's real current usage. The pipeline's ledger only sees its own spend,
# but the weekly pool is shared with interactive Claude Code sessions -- so
# when you reset, you usually want to start from where the account actually
# is, not from zero. That seed applies to the first period only.
#
#   ap reset-week              # anchor at now, start from $0
#   ap reset-week 14%          # anchor at now, start at 14% of the weekly cap
#   ap reset-week 43.40        # anchor at now, start at $43.40
#   ap reset-week 14% --days 7 # non-default period length
#
# Historical ledger entries are never modified -- the window simply starts
# here, so past spend stays on record and just falls outside the current week.
cmd_reset_week() {
  local seed="${1:-0}" days=7
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days) days="${2:-7}"; shift 2 ;;
      *) echo "ap reset-week: unknown argument '$1'" >&2; return 2 ;;
    esac
  done
  mkdir -p "$AP_HOME"
  python3 - "$AP_HOME" "$seed" "$days" "$AP_MAX_WEEK_COST_USD" <<'PYEOF'
import datetime, json, os, sys

home, seed_raw, days_raw, cap_raw = sys.argv[1:5]

try:
    days = int(days_raw)
    if days < 1:
        raise ValueError
except ValueError:
    print("ap reset-week: --days must be a positive integer", file=sys.stderr)
    sys.exit(2)

seed_raw = str(seed_raw).strip().lstrip("$")
try:
    if seed_raw.endswith("%"):
        baseline = float(seed_raw[:-1]) / 100.0 * float(cap_raw)
    else:
        baseline = float(seed_raw or 0)
except ValueError:
    print("ap reset-week: seed must be a dollar amount or a percentage "
          "(e.g. 43.40 or 14%)", file=sys.stderr)
    sys.exit(2)
if baseline < 0:
    print("ap reset-week: seed cannot be negative", file=sys.stderr)
    sys.exit(2)

now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
stamp = now.strftime("%Y-%m-%dT%H:%M:%SZ")
path = os.path.join(home, "week-reset.json")

prev = None
if os.path.exists(path):
    try:
        with open(path) as handle:
            prev = json.load(handle).get("anchor")
    except (OSError, ValueError):
        prev = None

state = {
    "anchor": stamp,
    "period_days": days,
    "baseline_usd": round(baseline, 2),
    "baseline_note": (
        "One-time sync to real account usage at reset time. Applies to the "
        "first period only; subsequent periods start from zero."
    ),
    "reset_at": stamp,
    "previous_anchor": prev,
}
with open(path, "w") as handle:
    json.dump(state, handle, indent=2)
    handle.write("\n")

end = now + datetime.timedelta(days=days)
print("week cost window re-anchored")
print("  anchor:   %s" % stamp)
print("  resets:   %s (every %d days)" % (end.strftime("%Y-%m-%dT%H:%M:%SZ"), days))
print("  starting: $%.2f" % baseline)
print("  state:    %s" % path)
print("  (historical ledger entries were not modified)")
PYEOF
}

[[ $# -ge 1 ]] || usage
sub="$1"; shift
case "$sub" in
  up) cmd_up "${1:-}" ;;
  down) cmd_down ;;
  status) cmd_status ;;
  pause) cmd_pause ;;
  resume) cmd_resume ;;
  reset-week) cmd_reset_week "$@" ;;
  runs) cmd_runs "$@" ;;
  run) cmd_run "$@" ;;
  tail) cmd_tail "$@" ;;
  watch) cmd_watch "$@" ;;
  sweep) cmd_sweep "$@" ;;
  sessions) cmd_sessions ;;
  pause-act) cmd_pause_act "${1:-}" ;;
  resume-act) cmd_resume_act "${1:-}" "${2:-}" ;;
  retry) cmd_retry "${1:-}" ;;
  queue) cmd_queue "$@" ;;
  approve) cmd_approve "$@" ;;
  reply) cmd_reply "$@" ;;
  decide) cmd_decide "$@" ;;
  --print-paths) cmd_print_paths ;;
  *) usage ;;
esac
