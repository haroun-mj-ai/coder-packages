#!/usr/bin/env bash
set -euo pipefail

# n8n-glm-credential — create/refresh the "LunaRoute GLM" OpenAI-compatible
# credential in the personal n8n (see n8n-up). Run after creating the n8n owner
# account, and again after a `lunaroute login` changes the routing key.
#
# The key goes lunaroute -> python -> docker exec stdin -> n8n's encrypted store.
# It is never printed, never in argv, and the temp file inside the container is
# removed immediately after import. A fixed credential id makes re-runs update
# in place.

NAME=n8n-haroun
docker inspect "$NAME" >/dev/null 2>&1 || { echo "n8n not running (run: n8n-up)" >&2; exit 1; }

python3 -I - <<'EOF' | docker exec -i "$NAME" sh -c 'umask 077; cat > /tmp/glm-cred.json'
import json, subprocess, sys
key = subprocess.run(["lunaroute", "key"], capture_output=True, text=True, check=True).stdout.strip()
if not key:
    sys.exit("lunaroute key returned nothing; run lunaroute login")
json.dump([{
    "id": "lunaroutGLM00001",
    "name": "LunaRoute GLM",
    "type": "openAiApi",
    "data": {"apiKey": key, "url": "https://gw.lunaroute.com/v1"},
}], sys.stdout)
EOF

status=0
docker exec "$NAME" n8n import:credentials --input=/tmp/glm-cred.json 2>&1 | grep -vi 'apikey' | tail -3 || status=$?
docker exec "$NAME" rm -f /tmp/glm-cred.json
exit $status
